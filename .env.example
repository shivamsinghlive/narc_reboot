# Copy to .env and fill in. Everything can also be set from the Settings drawer in the UI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional: OpenAI-compatible endpoint (Azure, proxy, local)
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional but recommended: raises GitHub API limits and enables private repos
GITHUB_TOKEN=
# Optional Jira Cloud
JIRA_SITE=https://your-team.atlassian.net
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_JQL=statusCategory != Done ORDER BY updated DESC
PORT=4317
# Optional: cheaper/faster model for light calls (layer checks, doc extraction, backlog mapping, narratives)
OPENAI_FAST_MODEL=
# Optional threat intel (web search for exploits/advisories)
TAVILY_API_KEY=
EXA_API_KEY=
# Local AI: run every AI call on this laptop via Ollama (code and PR text never leave). Also a switch in Settings.
NARC_LOCAL_AI=0
LOCAL_MODEL=qwen2.5:7b
LOCAL_BASE_URL=http://127.0.0.1:11434/v1
